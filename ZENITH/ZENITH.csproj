    <!-- Self-Contained Deployment Configuration -->
    <!-- RuntimeIdentifier: Chỉ định nền tảng mục tiêu (có thể ghi đè bằng tham số -r) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- SelfContained: Đóng gói .NET Runtime vào thư mục publish -->
    <SelfContained>true</SelfContained>
    <!-- PublishSingleFile: Đóng gói thành một file thực thi duy nhất -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- IncludeNativeLibrariesForSelfExtract: Bao gồm các thư viện native khi dùng PublishSingleFile -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

